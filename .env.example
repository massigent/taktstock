# ════════════════════════════════════════════════════════════
# Taktstock Multi-Agent Orchestrator - Environment Variables
# ════════════════════════════════════════════════════════════

# OpenAI (Director GPT-5.6 Terra / Sol)
OPENAI_API_KEY="sk-..."

# DeepSeek (Reviewer 2 V4 Pro & Fixer V4 Flash)
DEEPSEEK_API_KEY="sk-..."

# OpenRouter (Reviewer 1 GLM / Claude / Open Source models)
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_GLM_MODEL="z-ai/glm-5.3"

# Zhipu BigModel (Optional, direct alternative for GLM)
ZHIPU_API_KEY=""
ZHIPU_GLM_MODEL="glm-4-plus"

# Claude CLI Proxy Token (Optional)
CLAUDE_GLM_TOKEN=""
CLAUDE_GLM_URL="https://openrouter.ai/api/v1"
CLAUDE_GLM_MODEL="z-ai/glm-5.3"

# GitHub Token (for git clone and push)
GITHUB_TOKEN=""

# Antigravity CLI (agy) & Gemini
AGY_MODEL=""
GEMINI_MODEL="gemini-2.5-flash"
AGY_TIMEOUT="15m"

# Webhook n8n (local default)
WEBHOOK_URL="http://localhost:5678/webhook/taktstock-progress"

# ════════════════════════════════════════════════════════════
# Security & Authentication (Cloudflare / Web / Telegram)
# ════════════════════════════════════════════════════════════
# Secret Password or Token to access Web Dashboard and protect APIs (at least 16 characters)
TAKTSTOCK_AUTH_TOKEN="your-super-secret-token-at-least-16-chars"

# Telegram Allowlist: Authorized user IDs separated by comma (e.g.: "123456789,987654321")
TELEGRAM_ALLOWED_USER_IDS=""
